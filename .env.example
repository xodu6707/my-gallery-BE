# Optional path to the independent frontend checkout, relative to this Compose file.
FRONTEND_PATH=../frontend
# Optional URL for the host-side Python readiness script.
COMFYUI_URL=http://127.0.0.1:8188
OWNER_EMAIL=owner@example.com
REGISTRATION_OPEN=true
PUBLIC_URL=http://localhost:15173
PHOTO_MAX_BYTES=52428800
PHOTO_MAX_PIXELS=100000000
# Local-only service credential. Replace outside development.
INGEST_TOKEN=local-development-ingest-token-change-me
